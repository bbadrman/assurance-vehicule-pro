	<script>
		// FAQ Pagination
		(function() {
			const container = document.getElementById('faq-items');
			const paginationEl = document.getElementById('faq-pagination');
			if (!container || !paginationEl) return;

			const items = Array.from(container.querySelectorAll(':scope > div'));
			const itemsPerPage = parseInt(container.dataset.itemsPerPage, 10) || 5;
			let currentPage = 1;
			const totalPages = Math.ceil(items.length / itemsPerPage);

			if (totalPages <= 1) return;

			function goToPage(page) {
				currentPage = Math.max(1, Math.min(page, totalPages));
				render();
			}

			function render() {
				const start = (currentPage - 1) * itemsPerPage;
				const end = start + itemsPerPage;

				items.forEach((item, index) => {
					item.style.display = index >= start && index < end ? '' : 'none';
				});

				paginationEl.innerHTML = '';

				const wrapper = document.createElement('div');
				wrapper.className = 'faq-pagination-wrapper';

				const prevBtn = document.createElement('button');
				prevBtn.type = 'button';
				prevBtn.className = 'faq-nav-btn';
				prevBtn.disabled = currentPage === 1;
				prevBtn.setAttribute('aria-label', 'Page précédente');
				prevBtn.innerHTML = '<i class="fas fa-chevron-left"></i><span class="faq-nav-label">Précédent</span>';
				prevBtn.addEventListener('click', () => goToPage(currentPage - 1));
				wrapper.appendChild(prevBtn);

				for (let page = 1; page <= totalPages; page++) {
					const btn = document.createElement('button');
					btn.type = 'button';
					btn.textContent = page;
					btn.className = 'faq-page-btn' + (page === currentPage ? ' active' : '');
					btn.setAttribute('aria-label', 'Aller à la page ' + page);
					if (page === currentPage) btn.setAttribute('aria-current', 'page');
					btn.addEventListener('click', () => goToPage(page));
					wrapper.appendChild(btn);
				}

				const nextBtn = document.createElement('button');
				nextBtn.type = 'button';
				nextBtn.className = 'faq-nav-btn';
				nextBtn.disabled = currentPage === totalPages;
				nextBtn.setAttribute('aria-label', 'Page suivante');
				nextBtn.innerHTML = '<span class="faq-nav-label">Suivant</span><i class="fas fa-chevron-right"></i>';
				nextBtn.addEventListener('click', () => goToPage(currentPage + 1));
				wrapper.appendChild(nextBtn);

				const info = document.createElement('div');
				info.className = 'faq-pagination-info';
				info.textContent = 'Page ' + currentPage + ' sur ' + totalPages;
				wrapper.appendChild(info);

				paginationEl.appendChild(wrapper);
			}

			render();
		})();
	</script>

